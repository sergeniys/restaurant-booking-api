# Project
PROJECT_NAME="Restaurant Booking API"
VERSION="1.0.0"

# Database
DATABASE_URL=sqlite+aiosqlite:///./bookings.db
ECHO_SQL=False

# Business Rules
MAX_TABLES_PER_SLOT=10
BOOKING_MAX_DAYS_AHEAD=90
BOOKING_OPEN_HOUR=12
BOOKING_CLOSE_HOUR=22
TIMEZONE=Europe/Moscow

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100
